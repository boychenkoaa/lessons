#load "mytest.fs"
open MyTest

multicheck "40.1 sum" [
    ("чётные", "(fun x -> x % 2 = 0), [1;2;3;4;5;6]", 12, sum ((fun x -> x % 2 = 0), [1;2;3;4;5;6]))
    ("положительные", "(fun x -> x > 0), [-3;2;-1;4]", 6, sum ((fun x -> x > 0), [-3;2;-1;4]))
]

multicheck "40.2.1 count" [
    ("дубликаты", "([1;2;2;2;4], 2)", 3, count ([1;2;2;2;4], 2))
    ("элемент отсутствует", "([1;2;4], 3)", 0, count ([1;2;4], 3))
]

multicheck "40.2.2 insert" [
    ("пустой список", "([], 2)", [2], insert ([], 3))
    ("вставка в середину", "([1;3;5], 4)", [1;3;4;5], insert ([1;3;5], 4))
    ("вставка в конец", "([1;3;5], 7)", [1;3;5;7], insert ([1;3;5], 7))
    ("дубликаты", "([1;2;2;4], 2)", [1;2;2;2;4], insert ([1;2;2;4], 2))
]

multicheck "40.2.3 intersect" [
    ("дубликаты", "([1;2;2;2;5], [2;2;4])", [2;2], intersect ([1;2;2;2;5], [2;2;4]))
    ("нет общих элементов", "([1;3;5], [2;4])", [], intersect ([1;3;5], [2;4]))
]

multicheck "40.2.4 plus" [
    ("дубликаты", "([1;2;2;4], [2;3])", [1;2;2;2;3;4], plus ([1;2;2;4], [2;3]))
    ("первый список пуст", "([], [1;2])", [1;2], plus ([], [1;2]))
]

multicheck "40.2.5 minus" [
    ("дубликаты", "([1;1;2;4], [1;3])", [1;2;4], minus ([1;1;2;4], [1;3]))
    ("удаление из середины", "([1;2;3], [2])", [1;3], minus ([1;2;3], [2]))
    ("второй список пуст", "([1;2;3], [])", [1;2;3], minus ([1;2;3], []))
]

multicheck "40.3.1 smallest" [
    ("минимум повторяется", "[3;1;4;1;2]", Some 1, smallest [3;1;4;1;2])
    ("один элемент", "[7]", Some 7, smallest [7])
    ("пустой список", "[]", None, smallest [])
]

multicheck "40.3.2 delete" [
    ("первое вхождение", "(2, [3;2;1;2])", [3;1;2], delete (2, [3;2;1;2]))
    ("элемент отсутствует", "(5, [3;2;1])", [3;2;1], delete (5, [3;2;1]))
    ("пустой список", "(1, [])", [], delete (1, []))
]

multicheck "40.3.3 sort" [
    ("дубликаты", "[3;1;2;1]", [1;1;2;3], sort [3;1;2;1])
    ("пустой список", "[]", [], sort ([] : int list))
]

multicheck "40.4 revrev" [
    ("несколько списков", "[[1;2];[3;4;5]]", [[5;4;3];[2;1]], revrev [[1;2];[3;4;5]])
    ("пустой список", "[]", [], revrev ([] : int list list))
]
