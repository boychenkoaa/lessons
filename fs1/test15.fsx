#load "mytest.fs"
open MyTest

multicheck "41.4.1 list_filter" [
    ("чётные с сохранением порядка", "(fun x -> x % 2 = 0), [1;2;3;4;5;6]", [2;4;6], list_filter (fun x -> x % 2 = 0) [1;2;3;4;5;6])
    ("ни один элемент не подходит", "(fun x -> x > 10), [1;2;3]", [], list_filter (fun x -> x > 10) [1;2;3])
    ("пустой список", "(fun x -> x % 2 = 0), []", [], list_filter (fun x -> x % 2 = 0) [])
]

multicheck "41.4.2 sum" [
    ("сумма чётных", "(fun x -> x % 2 = 0), [1;2;3;4;5;6]", 12, sum ((fun x -> x % 2 = 0), [1;2;3;4;5;6]))
    ("ни один элемент не подходит", "(fun x -> x > 10), [1;2;3]", 0, sum ((fun x -> x > 10), [1;2;3]))
    ("пустой список", "(fun x -> x > 0), []", 0, sum ((fun x -> x > 0), []))
]

multicheck "41.4.3 revrev" [
    ("несколько списков разной длины", "[[1;2];[3;4;5];[6]]", [[6];[5;4;3];[2;1]], revrev [[1;2];[3;4;5];[6]])
    ("пустые вложенные списки", "[[];[1;2];[]]", [[];[2;1];[]], revrev [[];[1;2];[]])
    ("пустой внешний список", "[]", [], revrev ([] : int list list))
]
